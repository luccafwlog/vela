{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-x}; c=${VERCEL_GIT_COMMIT_SHA:-x}; [ \"$p\" = \"$c\" ] && exit 1; git diff --quiet \"$p\" \"$c\" -- . 2>/dev/null || exit 1",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?:portalfwlog\\.com\\.br|fwlog-portal(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "^(?:portalfwlog\\.com\\.br|fwlog-portal(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "has": [
        {
          "type": "host",
          "value": "^(?:vela\\.app\\.br|vela(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal",
      "has": [
        {
          "type": "host",
          "value": "^(?:vela\\.app\\.br|vela(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "https://portalfwlog.com.br/portal",
      "permanent": false
    },
    {
      "source": "/portal/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:vela\\.app\\.br|vela(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "https://portalfwlog.com.br/portal/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "^(?:portalfwlog\\.com\\.br|fwlog-portal(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/portal.html"
    },
    {
      "source": "/portal.html",
      "has": [
        {
          "type": "host",
          "value": "^(?:vela\\.app\\.br|vela(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets(?:/|$)|branding(?:/|$)|.*\\.[^/]+$).*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:vela\\.app\\.br|vela(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets(?:/|$)|branding(?:/|$)|.*\\.[^/]+$).*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:portalfwlog\\.com\\.br|fwlog-portal(?:-[a-z0-9-]+)?(?:-luccafwlogs-projects)?\\.vercel\\.app)$"
        }
      ],
      "destination": "/portal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://olinda.bcb.gov.br https://*.ingest.us.sentry.io https://eu.i.posthog.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/portal.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
