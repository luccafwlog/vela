{
  "name": "vela",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync": "git fetch origin --prune && git pull --ff-only",
    "sync:hard": "git fetch origin --prune && git reset --hard origin/main && git clean -fd",
    "dev": "vite",
    "docs:check": "node scripts/check-docs.mjs",
    "rpc:check": "node scripts/check-rpc-catalog.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/integration/supabase.integration.test.ts",
    "size-limit": "node scripts/check-size-limit.mjs",
    "preview": "vite preview",
    "perf:authenticated-startup": "node scripts/perf/measure-authenticated-startup.mjs",
    "perf:operational-read-model": "node scripts/perf/measure-operational-read-model.mjs",
    "a11y:contrast": "node scripts/check-theme-contrast.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "^5.96.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
