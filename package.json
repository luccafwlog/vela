{
  "name": "vela",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync": "git fetch origin --prune && git pull --ff-only",
    "sync:hard": "git fetch origin --prune && git reset --hard origin/main && git clean -fd",
    "skills:report": "node scripts/skills/report-skills.mjs --label local",
    "skills:report:json": "node scripts/skills/report-skills.mjs --label local --format json",
    "skills:usage": "node scripts/skills/report-skill-usage.mjs",
    "skills:usage:json": "node scripts/skills/report-skill-usage.mjs --format json",
    "skills:reset": "node scripts/skills/skill-reset.mjs",
    "skills:sync": "node scripts/skills/skill-sync.mjs --prune-owned",
    "dev": "vite",
    "docs:check": "node scripts/check-docs.mjs",
    "rpc:check": "node scripts/check-rpc-catalog.mjs",
    "migrations:check": "node scripts/check-destructive-migrations.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/clean-build-artifacts.mjs dist",
    "cloudflare:build:sites": "npm run build && node scripts/cloudflare-pages-stage.mjs internal dist dist/pages-internal && node scripts/cloudflare-pages-stage.mjs portal dist dist/pages-portal",
    "cloudflare:build:internal": "npm run build && node scripts/cloudflare-pages-stage.mjs internal dist dist/pages-internal",
    "cloudflare:build:portal": "npm run build && node scripts/cloudflare-pages-stage.mjs portal dist dist/pages-portal",
    "cloudflare:stage:test": "node --test scripts/cloudflare-pages-stage.test.mjs scripts/cloudflare-preview-env.test.mjs scripts/cloudflare-pages-cleanup.test.mjs scripts/cloudflare-pages-workflow.test.mjs",
    "cloudflare:provision:test": "node --test scripts/cloudflare-pages-provision.test.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/integration/supabase.integration.test.ts",
    "size-limit": "node scripts/check-size-limit.mjs",
    "preview": "vite preview",
    "perf:authenticated-startup": "node scripts/perf/measure-authenticated-startup.mjs",
    "perf:operational-read-model": "node scripts/perf/measure-operational-read-model.mjs",
    "a11y:contrast": "node scripts/check-theme-contrast.mjs",
    "backup:r2": "node scripts/backup-r2.mjs",
    "backup:r2:test": "node --test scripts/backup-r2.test.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@sentry/react": "^11.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.435.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "size-limit": "^14.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.147.0"
  }
}
