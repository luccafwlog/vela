VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# URLs do Portal usadas nos comunicados enviados ao cliente.
# Opcionais: quando ausentes, o codigo cai no padrao de producao
# (VITE_PORTAL_BILLING_URL -> VITE_PORTAL_URL + /portal/billing -> constante interna).
VITE_PORTAL_URL=https://portalfwlog.com.br
VITE_PORTAL_BILLING_URL=https://portalfwlog.com.br/portal/billing

# Sentry browser DSNs are public identifiers, not server secrets. Configure
# separate values in the Vercel projects `vela` and `fwlog-portal`; empty
# values preserve the current compatibility DSN until that split is ready.
VITE_SENTRY_DSN_INTERNAL=
VITE_SENTRY_DSN_PORTAL=
# Use `production` for Production and `preview` for Preview deployments.
VITE_SENTRY_ENVIRONMENT=development

# Testes de integracao (Supabase real)
# Rode apenas em ambiente controlado:
# SUPABASE_RUN_INTEGRATION=1 npm run test:integration
SUPABASE_RUN_INTEGRATION=0
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_INTEGRATION_EMAIL=admin.teste@empresa.com
SUPABASE_INTEGRATION_PASSWORD=senha-forte
SUPABASE_TEST_VOYAGE_ID=1
SUPABASE_TEST_BL_ID=CSC000000001
SUPABASE_TEST_BL_ID_WITH_CE=CSC000000001
SUPABASE_TEST_BILLING_BL_IDS=CSC000000001,CSC000000002
SUPABASE_OPERATOR_EMAIL=operador.teste@empresa.com
SUPABASE_OPERATOR_PASSWORD=senha-forte
